; ModuleID = '../../trampoline_lib/ict_checking.c'
source_filename = "../../trampoline_lib/ict_checking.c"
target datalayout = "e-m:e-p:32:32-i64:64-v128:64:128-a:0:32-n32-S64"
target triple = "armv6kz--linux-gnueabihf"

%struct.RingBuffer = type { [10000000 x %struct.Element], i32, i32 }
%struct.Element = type { i32, i32, i32, i8 }

@ringbuffer_init_flag = global i32 0, align 4
@ringBuffer = common global %struct.RingBuffer zeroinitializer, align 4
@recording_flag = external global i32, align 4
@.str = private unnamed_addr constant [16 x i8] c"buffer is full\0A\00", align 1
@.str.1 = private unnamed_addr constant [39 x i8] c"!!!!!!!!!!!!!!!!PANIC!!!!!!!!!!!!!!!!\0A\00", align 1
@cnt = global i32 0, align 4
@.str.2 = private unnamed_addr constant [40 x i8] c"!!!!!!!!!!!!!!!!fwd_indirect_tsf works\0A\00", align 1
@current_cpt_id = common global i32 0, align 4

